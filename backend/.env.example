# Copy to .env. Every key is optional.
# Report text is written by Snowflake Cortex if both SNOWFLAKE_* are set, otherwise by Gemini.
# Force one with LLM_PROVIDER=snowflake or LLM_PROVIDER=gemini.
# Snowflake account identifier (orgname-account_name) or account URL, and a programmatic access token
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_PAT=
# SNOWFLAKE_MODEL=claude-sonnet-4-5
# Gemini API key (Google AI Studio): https://aistudio.google.com/api-keys
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Extra allowed browser origins, comma-separated (the Svelte dev server is allowed by default)
# CORS_ORIGINS=http://localhost:5173
# PORT=8000
