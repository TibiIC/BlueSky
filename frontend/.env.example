# Copy to .env and fill in what you have. Every key is optional; see README for what each unlocks.
# Cesium ion: https://ion.cesium.com/tokens
PUBLIC_CESIUM_ION_TOKEN=
# Google Map Tiles API (optional, otherwise Google 3D tiles come via Cesium ion)
PUBLIC_GOOGLE_MAPS_API_KEY=
# National Land Survey of Finland: https://www.maanmittauslaitos.fi/en/rajapinnat/api-avaimen-ohje
PUBLIC_NLS_API_KEY=
